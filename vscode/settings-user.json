{
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  EDITOR · behavior                                                     │
  // └────────────────────────────────────────────────────────────────────────┘
  "editor.formatOnSave": true,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.tabCompletion": "on",
  "editor.linkedEditing": true,
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  EDITOR · appearance                                                   │
  // └────────────────────────────────────────────────────────────────────────┘
  "editor.wordWrap": "off",
  "editor.renderWhitespace": "none",
  "editor.fontLigatures": true,
  "editor.mouseWheelZoom": true,
  "editor.stickyScroll.enabled": true,
  "editor.minimap.enabled": true,
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  FILES                                                                 │
  // └────────────────────────────────────────────────────────────────────────┘
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    ".env.*": "dotenv",
    "*.jsonl": "plaintext"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/logs/**": true
  },
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  SEARCH                                                                │
  // └────────────────────────────────────────────────────────────────────────┘
  "search.exclude": {
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/venv": true,
    "**/uv.lock": true
  },
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  EXPLORER                                                              │
  // └────────────────────────────────────────────────────────────────────────┘
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "pyproject.toml": "uv.lock, .python-version, ruff.toml, .ruff.toml, pytest.ini, setup.cfg, setup.py, tox.ini, mypy.ini, requirements*.txt, MANIFEST.in",
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, turbo.json, .nvmrc, .npmrc, .node-version, .editorconfig, commitlint.config.*, eslint.config.*, .prettierrc*, .prettierignore, .lintstagedrc*, .gitattributes, bun.lockb, yarn.lock, package-lock.json",
    "tsconfig.json": "tsconfig.*.json",
    "README.md": "CONTRIBUTING.md, LICENSE, CHANGELOG.md, SECURITY.md, START.md",
    ".env": ".env.*, .env.local, .env.example, .env.test",
    "docker-compose.yml": "docker-compose.*.yml, Dockerfile*, .dockerignore",
    "Dockerfile": "Dockerfile*, .dockerignore",
    "vite.config.*": "vitest.config.*, playwright.config.*, tailwind.config.*, postcss.config.*",
    "drizzle.config.ts": "drizzle.config.*, drizzle/*",
    "*.sqlite": "${capture}.${extname}-*, ${capture}.db*",
    "*.db": "${capture}.${extname}-*",
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map",
    "*.tsx": "${capture}.ts, ${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js"
  },
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  WORKBENCH                                                             │
  // └────────────────────────────────────────────────────────────────────────┘
  "workbench.colorTheme": "Dark+", // Dark+, One Dark Pro
  "workbench.iconTheme": "material-icon-theme", // material-icon-theme, vs-seti, vs-minimal
  "workbench.startupEditor": "none",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 12,
  "workbench.editor.limit.perEditorGroup": true,
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  TERMINAL                                                              │
  // └────────────────────────────────────────────────────────────────────────┘
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.scrollback": 10000,
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  GIT                                                                   │
  // └────────────────────────────────────────────────────────────────────────┘
  "git.enableSmartCommit": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  SECURITY                                                              │
  // └────────────────────────────────────────────────────────────────────────┘
  "security.workspace.trust.untrustedFiles": "prompt",
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  LANG · Python                                                         │
  // └────────────────────────────────────────────────────────────────────────┘
  "[python]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.rulers": [
      100
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": false,
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests"
  ],
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  LANG · Notebooks                                                      │
  // └────────────────────────────────────────────────────────────────────────┘
  "notebook.formatOnSave.enabled": true,
  "notebook.codeActionsOnSave": {
    "notebook.source.fixAll": "explicit",
    "notebook.source.organizeImports": "explicit"
  },
  "notebook.lineNumbers": "on",
  "notebook.output.textLineLimit": 60,
  "notebook.diff.ignoreMetadata": true,
  "notebook.diff.ignoreOutputs": true,
  "jupyter.askForKernelRestart": false,
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  LANG · Data & config formats                                          │
  // └────────────────────────────────────────────────────────────────────────┘
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.wordWrap": "on",
    "editor.inlineSuggest.enabled": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.wordWrap": "on"
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.autoIndent": "keep",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    }
  },
  "[toml]": {
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },
  "[shellscript]": {
    "editor.tabSize": 2
  },
  "json.schemaDownload.enable": true,
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  LANG · Web                                                            │
  // │  Built-in formatters.                                                  │
  // └────────────────────────────────────────────────────────────────────────┘
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  // ┌────────────────────────────────────────────────────────────────────────┐
  // │  EXTENSIONS                                                            │
  // └────────────────────────────────────────────────────────────────────────┘
  "claudeCode.preferredLocation": "panel",
  "chat.viewSessions.orientation": "stacked",
  "remote.autoForwardPortsSource": "hybrid",
}
